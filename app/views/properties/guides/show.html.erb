<div class="mb-2 flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold tracking-tight">Montar o guia — <%= @property.name %></h1>
  <%= link_to "Voltar", property_path(@property),
        class: "shrink-0 rounded text-sm font-medium text-gray-600 underline decoration-gray-300 underline-offset-4 transition-colors hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2" %>
</div>
<p class="mb-8 max-w-2xl text-sm leading-relaxed text-gray-600">
  <span class="font-semibold text-gray-900"><%= @progress[:filled] %> de <%= @progress[:total] %></span> categorias preenchidas.
  Categorias sem descrição ou ocultas não aparecem para o hóspede. Arraste pelo símbolo <span aria-hidden="true">⠿</span> para reordenar.
</p>

<div class="space-y-5" data-controller="sortable" data-sortable-url-value="<%= property_guide_reorder_path(@property) %>" role="list" aria-label="Categorias do guia, em ordem de exibição">
  <% @entries.each do |category, card| %>
    <div
      role="listitem"
      aria-labelledby="category-<%= category.id %>-heading"
      data-category-id="<%= category.id %>"
      class="rounded-xl border bg-white p-5 shadow-sm transition-colors <%= card&.hidden? ? "border-dashed border-yellow-300 bg-yellow-50/60 opacity-75" : "border-gray-200" %>"
    >
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span data-sortable-handle aria-hidden="true" class="cursor-grab select-none rounded px-1 text-lg leading-none text-gray-400 transition-colors hover:text-gray-600 active:cursor-grabbing">⠿</span>
          <h2 id="category-<%= category.id %>-heading" class="font-semibold text-gray-900"><%= category.name %></h2>
          <% unless category.standard? %>
            <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">minha categoria</span>
          <% end %>
          <% if card&.hidden? %>
            <span class="rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-800">oculta neste guia</span>
          <% end %>
        </div>
        <%= form_with url: property_guide_card_path(@property, category_id: category.id), method: :patch, scope: :card do |f| %>
          <%= f.hidden_field :hidden, value: card&.hidden? ? "0" : "1" %>
          <%= f.submit card&.hidden? ? "Mostrar" : "Ocultar",
                class: "cursor-pointer rounded text-sm font-medium text-gray-600 underline decoration-gray-300 underline-offset-4 transition-colors hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2" %>
        <% end %>
      </div>
      <%= form_with url: property_guide_card_path(@property, category_id: category.id), method: :patch, scope: :card do |f| %>
        <%= f.rich_text_area :description, value: card&.description, "aria-label": "Descrição da categoria #{category.name}" %>
        <%= f.submit "Salvar",
              class: "mt-3 cursor-pointer rounded-lg bg-gray-900 px-4 py-1.5 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 active:bg-gray-950" %>
      <% end %>
    </div>
  <% end %>
</div>
