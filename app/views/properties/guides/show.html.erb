<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <div class="flex items-center gap-3">
    <%= link_to property_path(@property), class: "text-sm text-gray-500 hover:text-gray-900 transition-colors flex items-center gap-1" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
      </svg>
    <% end %>
    <h1 class="text-2xl font-bold tracking-tight text-gray-900">Montar o guia — <%= @property.name %></h1>
  </div>
  <%= link_to "Voltar", property_path(@property),
        class: "shrink-0 rounded-lg px-3 py-1.5 text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 transition-colors focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2" %>
</div>

<div class="mb-6 p-4 rounded-lg border border-gray-200 bg-white">
  <p class="max-w-2xl text-sm text-gray-600">
    <span class="font-semibold text-gray-900"><%= @progress[:filled] %> de <%= @progress[:total] %></span> categorias preenchidas.
    Categorias sem descrição ou ocultas não aparecem para o hóspede. Arraste pelo ícone <span aria-hidden="true" class="text-gray-400">⠿</span> para reordenar.
  </p>
</div>

<div class="space-y-4" data-controller="sortable" data-sortable-url-value="<%= property_guide_reorder_path(@property) %>" role="list" aria-label="Categorias do guia, em ordem de exibição">
  <% @entries.each do |category, card| %>
    <article
      role="listitem"
      aria-labelledby="category-<%= category.id %>-heading"
      data-category-id="<%= category.id %>"
      class="rounded-lg border bg-white p-4 transition-all <%= card&.hidden? ? "border-dashed border-yellow-300 bg-yellow-50/60 opacity-75" : "border-gray-200 hover:border-gray-300" %>"
    >
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
          <span data-sortable-handle aria-hidden="true" class="cursor-grab select-none shrink-0 rounded px-1 text-lg leading-none text-gray-400 transition-colors hover:text-gray-600 active:cursor-grabbing">⠿</span>
          <div class="min-w-0 flex items-center gap-2 flex-wrap">
            <h2 id="category-<%= category.id %>-heading" class="font-semibold text-gray-900 truncate"><%= category.name %></h2>
            <% unless category.standard? %>
              <span class="shrink-0 rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">Sua categoria</span>
            <% end %>
            <% if card&.hidden? %>
              <span class="shrink-0 rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-800">Oculta</span>
            <% end %>
          </div>
        </div>
        <%= form_with url: property_guide_card_path(@property, category_id: category.id), method: :patch, scope: :card do |f| %>
          <%= f.hidden_field :hidden, value: card&.hidden? ? "0" : "1" %>
          <%= f.submit card&.hidden? ? "Mostrar" : "Ocultar",
                class: "shrink-0 rounded px-3 py-1.5 text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 transition-colors focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 cursor-pointer" %>
        <% end %>
      </div>
      <%= form_with url: property_guide_card_path(@property, category_id: category.id), method: :patch, scope: :card do |f| %>
        <div class="trix-wrapper">
          <%= f.rich_text_area :description, value: card&.description, "aria-label": "Descrição da categoria #{category.name}" %>
        </div>
        <div class="mt-3 flex justify-end">
          <%= f.submit "Salvar",
                class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 active:bg-gray-950 cursor-pointer" %>
        </div>
      <% end %>
    </article>
  <% end %>
</div>