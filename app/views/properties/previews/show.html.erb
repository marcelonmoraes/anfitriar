<div class="mb-6">
  <div class="mb-4 flex items-start gap-2 rounded-lg border border-yellow-200 bg-yellow-50 p-3 text-sm text-yellow-800" role="note">
    <span aria-hidden="true">⚠️</span>
    <p>Pré-visualização bruta — o visual final do guia do hóspede chega no Subprojeto 3.</p>
  </div>
  <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @property.name %></h1>
  <p class="text-gray-600"><%= @property.address %></p>
</div>

<% if @cards.none? %>
  <p class="rounded-lg border border-dashed border-gray-300 p-8 text-center text-gray-500">
    Nenhum card preenchido ainda.
    <%= link_to "Montar o guia", property_guide_path(@property),
          class: "rounded font-medium text-gray-900 underline decoration-gray-300 underline-offset-4 transition-colors hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2" %>.
  </p>
<% else %>
  <div class="space-y-4" role="list" aria-label="Cards do guia, em ordem de exibição">
    <% @cards.each do |card| %>
      <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm" role="listitem" aria-labelledby="preview-card-<%= card.id %>-heading">
        <h2 id="preview-card-<%= card.id %>-heading" class="mb-2 font-semibold text-gray-900"><%= card.category.name %></h2>
        <div class="prose prose-sm max-w-none text-gray-700"><%= card.description %></div>
      </div>
    <% end %>
  </div>
<% end %>
