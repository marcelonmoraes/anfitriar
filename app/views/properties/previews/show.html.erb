<div class="mb-6">
  <div class="mb-4 flex items-start gap-2 rounded-lg border border-yellow-200 bg-yellow-50 p-3 text-sm text-yellow-800" role="note">
    <span aria-hidden="true">⚠️</span>
    <p>Pré-visualização bruta — o visual final do guia do hóspede chega no Subprojeto 3.</p>
  </div>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @property.name %></h1>
      <p class="text-gray-600"><%= @property.address %></p>
    </div>
    <div class="shrink-0">
      <%= link_to "Montar o guia", property_guide_path(@property),
            class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 active:bg-gray-950" %>
    </div>
  </div>
  <% if @property.description.present? %>
    <div class="mt-4 prose prose-sm max-w-none text-gray-700">
      <%= @property.description %>
    </div>
  <% end %>
</div>

<% if @cards.none? %>
  <div class="rounded-lg border border-dashed border-gray-300 p-8 text-center bg-white">
    <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-400">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
      </svg>
    </div>
    <h3 class="text-sm font-semibold text-gray-900">Nenhum card preenchido ainda</h3>
    <p class="mt-1 text-sm text-gray-500 max-w-sm mx-auto">
      Preencha as categorias do guia para que o hóspede veja as informações.
    </p>
    <div class="mt-4">
      <%= link_to "Montar o guia", property_guide_path(@property),
            class: "inline-flex items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2" %>
    </div>
  </div>
<% else %>
  <div class="space-y-4" role="list" aria-label="Cards do guia, em ordem de exibição">
    <% @cards.each do |card| %>
      <article class="rounded-xl border border-gray-200 bg-white p-5" role="listitem" aria-labelledby="preview-card-<%= card.id %>-heading">
        <h2 id="preview-card-<%= card.id %>-heading" class="mb-2 font-semibold text-gray-900"><%= card.category.name %></h2>
        <div class="prose prose-sm max-w-none text-gray-700"><%= card.description %></div>
      </article>
    <% end %>
  </div>
<% end %>