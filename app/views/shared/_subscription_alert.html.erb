<% subscription = Current.host&.subscription %>
<% if subscription %>
  <% if subscription.trial_expired? %>
    <div class="border-b border-red-200 bg-red-50" role="alert">
      <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6">
        <p class="text-sm text-red-900">
          <strong>Seu teste terminou.</strong> Seus guias estão fora do ar para os hóspedes.
        </p>
        <%= link_to "Assinar agora", new_account_subscription_path,
              class: "shrink-0 rounded-lg bg-red-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-red-800" %>
      </div>
    </div>
  <% elsif subscription.past_due? %>
    <div class="border-b border-amber-200 bg-amber-50" role="alert">
      <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6">
        <p class="text-sm text-amber-900">
          <strong>Pagamento pendente.</strong> Atualize seu cartão para não perder o acesso.
        </p>
        <%= link_to "Atualizar cartão", account_credit_cards_path,
              class: "shrink-0 rounded-lg bg-amber-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-amber-800" %>
      </div>
    </div>
  <% elsif subscription.trial? && subscription.trial_days_left <= 3 %>
    <div class="border-b border-blue-200 bg-blue-50" role="status">
      <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6">
        <p class="text-sm text-blue-900">
          Seu teste termina em <strong><%= pluralize(subscription.trial_days_left, "dia") %></strong>.
        </p>
        <%= link_to "Assinar", new_account_subscription_path,
              class: "shrink-0 rounded-lg bg-gray-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-gray-800" %>
      </div>
    </div>
  <% end %>
<% end %>
