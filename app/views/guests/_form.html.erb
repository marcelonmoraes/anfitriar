<%= form_with model: guest, class: "max-w-lg space-y-5" do |f| %>
  <%= render "shared/form_errors", record: guest %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, required: true, autofocus: true,
          class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none sm:text-sm" %>
  </div>
  <div>
    <%= f.label :cpf, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :cpf, required: true, placeholder: "000.000.000-00", autocomplete: "off",
          class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none sm:text-sm" %>
  </div>
  <div>
    <%= f.label :phone, class: "block text-sm font-medium text-gray-700" %>
    <%= f.telephone_field :phone, required: true, placeholder: "(11) 91234-5678", "aria-describedby": "guest_phone_hint",
          class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none sm:text-sm" %>
    <p id="guest_phone_hint" class="mt-1.5 text-xs text-gray-500">O hóspede confirmará o acesso ao guia com o CPF e os 4 últimos dígitos deste telefone.</p>
  </div>
  <div>
    <%= f.label :email, "E-mail (opcional)", class: "block text-sm font-medium text-gray-700" %>
    <%= f.email_field :email,
          class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none sm:text-sm" %>
  </div>
  <%= f.submit class: "rounded-lg bg-gray-900 px-4 py-2.5 font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 active:bg-gray-950" %>
<% end %>
