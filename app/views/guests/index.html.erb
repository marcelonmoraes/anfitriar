<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold">Clientes</h1>
  <%= link_to "Novo cliente", new_guest_path,
        class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 active:bg-gray-950" %>
</div>

<% if @guests.none? %>
  <p class="rounded-lg border border-dashed border-gray-300 p-8 text-center text-gray-500">
    Cadastre um cliente para poder criar reservas e liberar o guia.
  </p>
<% else %>
  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
    <table class="w-full text-sm">
      <caption class="sr-only">Clientes cadastrados</caption>
      <thead class="bg-gray-50 text-left">
        <tr>
          <th scope="col" class="px-4 py-2 font-medium text-gray-700">Nome</th>
          <th scope="col" class="px-4 py-2 font-medium text-gray-700">CPF</th>
          <th scope="col" class="px-4 py-2 font-medium text-gray-700">Telefone</th>
          <th scope="col" class="px-4 py-2"><span class="sr-only">Ações</span></th>
        </tr>
      </thead>
      <tbody>
        <% @guests.each do |guest| %>
          <tr class="border-t border-gray-200">
            <td class="px-4 py-2"><%= guest.name %></td>
            <td class="px-4 py-2 tabular-nums text-gray-600"><%= guest.masked_cpf %></td>
            <td class="px-4 py-2 tabular-nums text-gray-600"><%= guest.phone %></td>
            <td class="px-4 py-2 text-right">
              <%= link_to "Editar", edit_guest_path(guest),
                    class: "rounded font-medium text-gray-700 underline-offset-2 hover:underline focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2",
                    aria: { label: "Editar #{guest.name}" } %>
              <%= button_to "Excluir", guest_path(guest), method: :delete,
                    class: "ml-3 rounded font-medium text-red-700 underline-offset-2 hover:underline focus:outline-none focus:ring-2 focus:ring-red-600 focus:ring-offset-2",
                    form: { class: "inline", data: { turbo_confirm: "Excluir este cliente e seus dados?" } },
                    aria: { label: "Excluir #{guest.name}" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
