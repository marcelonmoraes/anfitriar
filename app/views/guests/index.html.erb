<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-gray-900">Clientes</h1>
    <p class="mt-1 text-sm text-gray-600">Cadastre hóspedes para criar reservas e liberar o acesso ao guia</p>
  </div>
  <%= link_to new_guest_path,
        class: "inline-flex items-center justify-center gap-2 rounded-lg bg-gray-900 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 active:bg-gray-950 shrink-0" do %>
    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
    </svg>
    Novo cliente
  <% end %>
</div>

<% if @guests.none? %>
  <div class="rounded-lg border border-dashed border-gray-300 p-8 text-center bg-white">
    <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-400">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0A5.971 5.971 0 0012 18.72m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm-9 3.75h.008v.008H6v-.008z" />
      </svg>
    </div>
    <h3 class="text-sm font-semibold text-gray-900">Nenhum cliente cadastrado</h3>
    <p class="mt-1 text-sm text-gray-500 max-w-sm mx-auto">
      Adicione o primeiro cliente para começar a criar reservas e liberar o acesso ao guia digital.
    </p>
    <div class="mt-4">
      <%= link_to "Cadastrar cliente", new_guest_path,
            class: "inline-flex items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2" %>
    </div>
  </div>
<% else %>
  <ul class="space-y-2 sm:hidden">
    <% @guests.each do |guest| %>
      <li class="rounded-lg border border-gray-200 bg-white p-4">
        <p class="font-medium text-gray-900"><%= guest.name %></p>
        <dl class="mt-2 space-y-1 text-sm">
          <div class="flex gap-2">
            <dt class="text-gray-500">CPF</dt>
            <dd class="font-mono tabular-nums text-gray-700"><%= guest.masked_cpf %></dd>
          </div>
          <div class="flex gap-2">
            <dt class="text-gray-500">Telefone</dt>
            <dd class="font-mono tabular-nums text-gray-700"><%= guest.phone %></dd>
          </div>
        </dl>
        <div class="mt-3 flex items-center gap-2 border-t border-gray-100 pt-3">
          <%= link_to "Editar", edit_guest_path(guest),
                class: "rounded-lg border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2",
                aria: { label: "Editar #{guest.name}" } %>
          <%= button_to "Excluir", guest_path(guest), method: :delete,
                class: "rounded-lg border border-red-300 px-3 py-2 text-sm font-medium text-red-700 transition-colors hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-600 focus:ring-offset-2",
                form: { data: { turbo_confirm: "Excluir este cliente e todos os seus dados? Esta ação é irreversível." } },
                aria: { label: "Excluir #{guest.name}" } %>
        </div>
      </li>
    <% end %>
  </ul>

  <div class="hidden overflow-x-auto rounded-lg border border-gray-200 bg-white sm:block">
    <table class="w-full text-sm">
      <caption class="sr-only">Clientes cadastrados</caption>
      <thead class="bg-gray-50 text-left">
        <tr>
          <th scope="col" class="px-4 py-3 font-medium text-gray-700">Nome</th>
          <th scope="col" class="px-4 py-3 font-medium text-gray-700">CPF</th>
          <th scope="col" class="px-4 py-3 font-medium text-gray-700">Telefone</th>
          <th scope="col" class="px-4 py-3"><span class="sr-only">Ações</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @guests.each do |guest| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-4 py-3 font-medium text-gray-900"><%= guest.name %></td>
            <td class="px-4 py-3 tabular-nums text-gray-600 font-mono text-sm"><%= guest.masked_cpf %></td>
            <td class="px-4 py-3 tabular-nums text-gray-600 font-mono text-sm"><%= guest.phone %></td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <%= link_to "Editar", edit_guest_path(guest),
                      class: "rounded-lg px-3 py-1.5 text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50 transition-colors focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2",
                      aria: { label: "Editar #{guest.name}" } %>
                <%= button_to "Excluir", guest_path(guest), method: :delete,
                      class: "rounded-lg px-3 py-1.5 text-sm font-medium text-red-600 hover:text-red-900 hover:bg-red-50 transition-colors focus:outline-none focus:ring-2 focus:ring-red-600 focus:ring-offset-2",
                      form: { class: "inline", data: { turbo_confirm: "Excluir este cliente e todos os seus dados? Esta ação é irreversível." } },
                      aria: { label: "Excluir #{guest.name}" } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>