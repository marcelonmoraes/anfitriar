<% content_for :title, "Cartões — Anfitriar" %>

<div class="mx-auto max-w-2xl">
  <header class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900">Formas de pagamento</h1>
    <p class="mt-1 text-sm text-gray-600">
      O cartão padrão é usado nas cobranças recorrentes da sua assinatura.
    </p>
  </header>

  <section class="mb-8">
    <% if @credit_cards.any? %>
      <ul class="space-y-3">
        <% @credit_cards.each do |credit_card| %>
          <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-gray-200 bg-white p-4">
            <div>
              <p class="flex items-center gap-2 font-medium text-gray-900">
                <%= credit_card %>
                <% if credit_card.default? %>
                  <span class="inline-flex items-center rounded-full bg-gray-900 px-2 py-0.5 text-xs font-medium text-white">Padrão</span>
                <% end %>
                <% if credit_card.expired? %>
                  <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800">Vencido</span>
                <% end %>
              </p>
              <p class="mt-0.5 text-sm text-gray-500">
                <%= credit_card.holder_name %> · expira em <%= credit_card.expires_on %>
              </p>
            </div>

            <div class="flex items-center gap-2">
              <% unless credit_card.default? %>
                <%= button_to "Tornar padrão", account_credit_card_default_path(credit_card),
                      class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
              <% end %>
              <%= button_to "Remover", account_credit_card_path(credit_card), method: :delete,
                    class: "rounded-lg border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50",
                    form: { data: { turbo_confirm: "Remover este cartão?" } } %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center">
        <p class="text-sm text-gray-500">Nenhum cartão cadastrado ainda.</p>
      </div>
    <% end %>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white p-5">
    <h2 class="text-lg font-semibold text-gray-900">Adicionar cartão</h2>

    <%= form_with model: @credit_card_form, url: account_credit_cards_path, scope: :credit_card,
          class: "mt-4 space-y-5", data: { controller: "credit-card", action: "submit->credit-card#submit" } do |form| %>
      <%= render "shared/form_errors", record: @credit_card_form %>
      <%= render "credit_cards/fields", form: form %>

      <div class="flex justify-end">
        <%= form.submit "Salvar cartão",
              class: "rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-gray-800 disabled:opacity-60",
              data: { credit_card_target: "submit" } %>
      </div>
    <% end %>
  </section>
</div>
