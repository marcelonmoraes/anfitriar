<div class="space-y-4">
  <div>
    <%= form.label :holder_name, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :holder_name,
          autocomplete: "cc-name",
          maxlength: 100,
          required: true,
          class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-gray-900" %>
  </div>

  <div>
    <div class="flex items-baseline justify-between">
      <%= form.label :number, class: "block text-sm font-medium text-gray-700" %>
      <span class="text-xs font-medium text-gray-500" data-credit-card-target="brand"></span>
    </div>
    <%= form.text_field :number,
          autocomplete: "cc-number",
          inputmode: "numeric",
          maxlength: 23,
          required: true,
          placeholder: t("credit_card_form.placeholders.number"),
          class: "mt-1 block w-full rounded-lg border-gray-300 font-mono shadow-sm focus:border-gray-900 focus:ring-gray-900",
          data: { credit_card_target: "number", action: "input->credit-card#formatNumber" } %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :expiry, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :expiry,
            autocomplete: "cc-exp",
            inputmode: "numeric",
            maxlength: 5,
            required: true,
            placeholder: t("credit_card_form.placeholders.expiry"),
            class: "mt-1 block w-full rounded-lg border-gray-300 font-mono shadow-sm focus:border-gray-900 focus:ring-gray-900",
            data: { credit_card_target: "expiry", action: "input->credit-card#formatExpiry" } %>
    </div>

    <div>
      <%= form.label :cvv, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :cvv,
            autocomplete: "cc-csc",
            inputmode: "numeric",
            maxlength: 4,
            required: true,
            placeholder: t("credit_card_form.placeholders.cvv"),
            class: "mt-1 block w-full rounded-lg border-gray-300 font-mono shadow-sm focus:border-gray-900 focus:ring-gray-900",
            data: { credit_card_target: "cvv", action: "input->credit-card#formatCvv" } %>
    </div>
  </div>

  <div>
    <%= form.label :document, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :document,
          inputmode: "numeric",
          maxlength: 18,
          placeholder: t("credit_card_form.placeholders.document"),
          class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-gray-900" %>
  </div>

  <p class="flex items-start gap-2 text-xs text-gray-500">
    <svg class="mt-0.5 h-4 w-4 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
    </svg>
    Os dados do cartão são enviados diretamente ao Asaas, nosso processador de pagamentos.
    O Anfitriar guarda apenas a bandeira e os 4 últimos dígitos.
  </p>
</div>
