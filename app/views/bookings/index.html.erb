<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold">Reservas</h1>
  <%= link_to "Nova reserva", new_booking_path,
        class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 active:bg-gray-950" %>
</div>

<h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">Ativas e futuras</h2>
<%= render "list", bookings: @current_bookings %>

<h2 class="mb-2 mt-8 text-sm font-semibold uppercase tracking-wide text-gray-500">Encerradas</h2>
<%= render "list", bookings: @finished_bookings %>
