<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold">Reserva — <%= @booking.guest.name %></h1>
    <p class="text-gray-600">
      <%= @booking.property.name %> · <%= l @booking.check_in %> a <%= l @booking.check_out %>
      · CPF <%= @booking.guest.masked_cpf %>
    </p>
  </div>
  <%= link_to "Voltar", bookings_path,
        class: "shrink-0 rounded text-sm font-medium text-gray-600 underline decoration-gray-300 underline-offset-4 transition-colors hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2" %>
</div>

<div class="rounded-lg border border-gray-200 bg-white p-4">
  <h2 class="mb-2 font-semibold text-gray-900">Link de acesso do hóspede</h2>
  <% if @booking.revoked? %>
    <p class="mb-3 text-sm text-red-700">Este link foi revogado. Gere um novo para restaurar o acesso.</p>
  <% elsif !@booking.link_active? %>
    <p class="mb-3 text-sm text-gray-600">A janela de acesso desta reserva terminou em <%= l @booking.accessible_until %>.</p>
  <% else %>
    <p class="mb-3 text-sm text-gray-600">Válido até <%= l @booking.accessible_until %> (check-out + margem).</p>
  <% end %>

  <p class="mb-3 break-all text-sm">
    <%= link_to guide_link_for(@booking), guide_link_for(@booking), target: "_blank", rel: "noopener",
          class: "text-gray-700 underline decoration-gray-300 underline-offset-4 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2" %>
  </p>

  <div class="flex gap-2" data-controller="clipboard">
    <label for="booking_guide_link" class="sr-only">Link de acesso do hóspede</label>
    <input type="text" id="booking_guide_link" readonly value="<%= guide_link_for(@booking) %>" data-clipboard-target="source"
           class="w-full rounded-lg border-gray-300 bg-gray-50 text-sm shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none">
    <button type="button" data-action="clipboard#copy" data-clipboard-target="button"
            class="shrink-0 rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2">Copiar</button>
  </div>

  <div class="mt-4 flex flex-wrap gap-2">
    <%= link_to "Enviar por WhatsApp", whatsapp_share_url(@booking), target: "_blank", rel: "noopener",
          class: "rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-600 focus:ring-offset-2" %>
    <%= link_to "Ver como hóspede", property_preview_path(@booking.property),
          class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2" %>
    <% if @booking.revoked? %>
      <%= button_to "Gerar novo link", reissue_booking_path(@booking), method: :patch,
            class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2" %>
    <% else %>
      <%= button_to "Revogar link", revoke_booking_path(@booking), method: :patch,
            class: "rounded-lg border border-red-300 px-4 py-2 text-sm font-medium text-red-700 transition-colors hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-600 focus:ring-offset-2",
            form: { data: { turbo_confirm: "O hóspede perderá o acesso imediatamente. Revogar?" } } %>
      <%= button_to "Regenerar link", reissue_booking_path(@booking), method: :patch,
            class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2",
            form: { data: { turbo_confirm: "O link atual deixará de funcionar. Continuar?" } } %>
    <% end %>
  </div>
</div>
