<div class="mx-auto mt-8 sm:mt-16 max-w-sm rounded-2xl border border-gray-200 bg-white p-6 sm:p-8 shadow-sm">
  <div class="mb-8 text-center">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900">Criar conta</h1>
    <p class="mt-1.5 text-sm text-gray-600">7 dias grátis, sem precisar de cartão.</p>
  </div>
  <%= form_with model: @host, url: registration_path, class: "space-y-4" do |f| %>
    <%= render "shared/form_errors", record: @host %>
    <div>
      <%= f.label :name, "Nome completo", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, required: true, autofocus: true, placeholder: "Seu nome",
            class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none text-sm px-3.5 py-2.5" %>
    </div>
    <div>
      <%= f.label :email_address, "E-mail", class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email_address, required: true, autocomplete: "username", placeholder: "voce@email.com",
            class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none text-sm px-3.5 py-2.5" %>
    </div>
    <div>
      <%= f.label :phone, "Telefone (WhatsApp)", class: "block text-sm font-medium text-gray-700" %>
      <%= f.telephone_field :phone, required: true, placeholder: "(11) 98765-4321",
            class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none text-sm px-3.5 py-2.5" %>
    </div>
    <div>
      <%= f.label :password, "Senha", class: "block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password, required: true, autocomplete: "new-password",
            class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none text-sm px-3.5 py-2.5" %>
    </div>
    <div>
      <%= f.label :password_confirmation, "Confirmar senha", class: "block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password",
            class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none text-sm px-3.5 py-2.5" %>
    </div>
    <%= f.submit "Criar conta", class: "w-full rounded-lg bg-gray-900 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 active:bg-gray-950 cursor-pointer" %>
  <% end %>
  <div class="mt-6 border-t border-gray-100 pt-4 text-center text-sm text-gray-600">
    Já tem conta? <%= link_to "Entrar", new_session_path, class: "font-semibold text-gray-900 hover:underline" %>
  </div>
</div>