<% content_for :title, "Acesso ao Guia — Anfitriar" %>

<div class="min-h-screen flex items-center justify-center p-4 bg-gray-50">
  <article class="w-full max-w-md rounded-2xl border border-gray-200 bg-white p-6 sm:p-8 shadow-sm">
    <div class="mb-8 text-center">
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="text-2xl font-bold tracking-tight text-gray-900">Anfitriar</span>
      </div>
      <h1 class="text-xl font-bold text-gray-900">Acesse seu guia</h1>
      <p class="mt-2 text-sm text-gray-500">Confirme sua identidade para visualizar o guia digital da hospedagem.</p>
    </div>

    <%= render "shared/flash" %>

    <%= form_with url: verify_submit_public_guide_path(@booking.access_token), class: "space-y-4" do |f| %>
      <div>
        <%= f.label :cpf, "CPF", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :cpf, required: true, placeholder: "000.000.000-00", autocomplete: "off",
              class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none text-sm px-3.5 py-2.5 font-mono" %>
      </div>

      <div>
        <%= f.label :phone_last4, "4 últimos dígitos do telefone", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :phone_last4, required: true, placeholder: "1234", maxlength: 4,
              class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none text-sm px-3.5 py-2.5 font-mono text-center" %>
      </div>

      <%= f.submit "Confirmar e acessar", class: "w-full rounded-lg bg-gray-900 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 active:bg-gray-950 cursor-pointer" %>
    <% end %>

    <p class="mt-6 text-center text-xs text-gray-400">
      O anfitrião cadastrou seus dados na reserva. O CPF e o telefone são usados apenas para confirmar seu acesso.
    </p>
  </article>
</div>