<% content_for :title, "#{@booking.property.name} — Guia do Hóspede" %>

<div class="min-h-screen bg-gray-50" data-controller="guide-modal">
  <!-- Sticky Header -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b border-gray-200">
    <div class="mx-auto max-w-2xl px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-lg font-bold tracking-tight text-gray-900">Anfitriar</span>
      </div>
      <div class="text-right">
        <p class="text-xs font-medium text-gray-900"><%= @booking.property.name %></p>
        <p class="text-[10px] text-gray-500">
          Check-in: <%= l @booking.check_in, format: :short %> · Check-out: <%= l @booking.check_out, format: :short %>
        </p>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-2xl px-4 py-8 pb-24">
    <% if @cards.any? %>
      <div class="space-y-3" id="guide-cards" role="list" aria-label="Categorias do guia">
        <% @cards.each do |card| %>
          <article class="rounded-xl border border-gray-200 bg-white p-4 sm:p-5 cursor-pointer hover:border-gray-300 transition-colors" 
                   role="listitem" 
                   aria-labelledby="card-<%= card.category.id %>-heading"
                   data-action="click->guide-modal#open"
                   data-guide-modal-card-id-value="<%= card.category.id %>"
                   data-guide-modal-title-value="<%= card.category.name %>"
                   data-guide-modal-content-value="<%= card.description.to_s.gsub('"', '"') %>">
            <h2 id="card-<%= card.category.id %>-heading" class="text-lg font-semibold text-gray-900 flex items-center gap-2">
              <%= category_icon(card.category.name) %>
              <%= card.category.name %>
              <svg class="ml-auto h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.5L8.25 12l6.75-7.5" />
              </svg>
            </h2>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-gray-100 text-gray-400">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-gray-900">Guia em preparação</h2>
        <p class="mt-2 text-sm text-gray-500">O anfitrião ainda não preencheu as informações deste guia.</p>
      </div>
    <% end %>
  </main>

  <!-- Bottom Bar (Mobile) -->
  <footer class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 px-4 py-3 md:hidden">
    <p class="text-center text-xs text-gray-500">
      Desenvolvido com cuidado por <strong class="text-gray-900">Anfitriar</strong>
    </p>
  </footer>

  <!-- Modal -->
  <dialog id="guide-modal" class="modal" aria-modal="true" aria-labelledby="modal-title" role="dialog" data-guide-modal-target="modal">
    <div class="modal-backdrop" data-action="click->guide-modal#close"></div>
    <div class="modal-content rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 max-w-lg w-full mx-4 my-auto max-h-[85vh] overflow-hidden flex flex-col">
      <header class="flex items-center justify-between mb-4 border-b border-gray-100 pb-3">
        <h2 id="modal-title" class="text-lg font-semibold text-gray-900" data-guide-modal-target="title"></h2>
        <button type="button" class="modal-close rounded-lg p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors" 
                data-action="click->guide-modal#close" aria-label="Fechar">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </header>
      <div id="modal-body" class="prose prose-gray prose-sm max-w-none text-gray-700 overflow-y-auto flex-1" data-guide-modal-target="body"></div>
    </div>
  </dialog>
</div>