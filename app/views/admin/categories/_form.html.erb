<%= form_with model: [:admin, category], class: "max-w-lg space-y-5" do |f| %>
  <%= render "shared/form_errors", record: category %>

  <div>
    <%= f.label :name, "Nome", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, required: true, autofocus: true, placeholder: "Ex: Wi-Fi",
          class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none text-sm px-3.5 py-2.5" %>
  </div>

  <div>
    <%= f.label :position, "Posição (ordem de exibição)", class: "block text-sm font-medium text-gray-700" %>
    <%= f.number_field :position, required: true, min: 1, value: category.position || Category.maximum(:position).to_i + 1,
          class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none text-sm px-3.5 py-2.5 font-mono" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 active:bg-gray-950 cursor-pointer" %>
    <%= link_to "Cancelar", admin_categories_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
  </div>
<% end %>