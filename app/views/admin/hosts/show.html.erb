<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <div class="flex items-center gap-2">
      <%= link_to admin_hosts_path, class: "text-sm text-gray-500 hover:text-gray-900 transition-colors flex items-center gap-1" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Anfitriões
      <% end %>
    </div>
    <h1 class="mt-1 text-2xl font-bold tracking-tight text-gray-900"><%= @host.name %></h1>
    <p class="mt-0.5 text-sm text-gray-600"><%= @host.email_address %></p>
  </div>
</div>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8">
  <article class="rounded-xl border border-gray-200 bg-white p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Hospedagens</p>
    <p class="mt-1 text-3xl font-bold text-gray-900"><%= @properties_count %></p>
  </article>

  <article class="rounded-xl border border-gray-200 bg-white p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Clientes</p>
    <p class="mt-1 text-3xl font-bold text-gray-900"><%= @guests_count %></p>
  </article>

  <article class="rounded-xl border border-gray-200 bg-white p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Preenchimento Médio dos Guias</p>
    <p class="mt-1 text-3xl font-bold text-gray-900"><%= @avg_guide_progress %>%</p>
  </article>

  <article class="rounded-xl border border-gray-200 bg-white p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Status da Assinatura</p>
    <div class="mt-1 flex items-center gap-2">
      <% if @subscription %>
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium
          <%= case @subscription.status
              when 'trial' then 'bg-blue-100 text-blue-800'
              when 'active' then 'bg-green-100 text-green-800'
              when 'past_due' then 'bg-yellow-100 text-yellow-800'
              when 'canceled' then 'bg-gray-100 text-gray-700'
              else 'bg-gray-100 text-gray-600'
              end %>">
          <%= @subscription.status.humanize %>
        </span>
        <span class="text-sm text-gray-600">
          <%= @subscription.plan ? @subscription.plan.name : "Sem plano" %>
        </span>
      <% else %>
        <span class="text-gray-400">Sem assinatura</span>
      <% end %>
    </div>
  </article>
</div>

<% if @subscription %>
  <section class="mb-8 rounded-xl border border-gray-200 bg-white p-5">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-gray-900">Detalhes da Assinatura</h2>
      <%= link_to "Editar Assinatura", edit_admin_host_subscription_path(@host),
            class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2" %>
    </div>

    <dl class="grid grid-cols-2 gap-4 text-sm">
      <div>
        <dt class="text-gray-500">Plano</dt>
        <dd class="font-semibold text-gray-900"><%= @subscription.plan.name %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Ciclo de Cobrança</dt>
        <dd class="font-semibold text-gray-900"><%= @subscription.billing_cycle.present? ? @subscription.billing_cycle.humanize : "—" %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Status</dt>
        <dd class="font-semibold text-gray-900">
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium
            <%= case @subscription.status
                when 'trial' then 'bg-blue-100 text-blue-800'
                when 'active' then 'bg-green-100 text-green-800'
                when 'past_due' then 'bg-yellow-100 text-yellow-800'
                when 'canceled' then 'bg-gray-100 text-gray-700'
                else 'bg-gray-100 text-gray-600'
                end %>">
            <%= @subscription.status.humanize %>
          </span>
        </dd>
      </div>
      <div>
        <dt class="text-gray-500">Trial expira em</dt>
        <dd class="font-semibold text-gray-900">
          <% if @subscription.trial? && @subscription.trial_ends_at %>
            <%= l @subscription.trial_ends_at.to_date %> (<%= @subscription.trial_days_left %> dias)
          <% else %>
            —
          <% end %>
        </dd>
      </div>
    </dl>
  </section>
<% else %>
  <div class="mb-8 rounded-xl border border-dashed border-gray-300 p-6 text-center bg-white">
    <h3 class="text-sm font-semibold text-gray-900">Nenhuma assinatura vinculada</h3>
    <p class="mt-1 text-sm text-gray-500">Crie uma assinatura para este anfitrião.</p>
    <div class="mt-4">
      <%= link_to "Criar assinatura", new_admin_host_subscription_path(@host),
            class: "inline-flex items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2" %>
    </div>
  </div>
<% end %>

<section class="rounded-xl border border-gray-200 bg-white">
  <div class="px-5 py-4 border-b border-gray-200">
    <h2 class="text-lg font-semibold text-gray-900">Hospedagens</h2>
  </div>
  <% if @host.properties.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-left">
          <tr>
            <th scope="col" class="px-4 py-3 font-medium text-gray-700">Nome</th>
            <th scope="col" class="px-4 py-3 font-medium text-gray-700">Endereço</th>
            <th scope="col" class="px-4 py-3 font-medium text-gray-700">Preenchimento</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @host.properties.includes(:cards).each do |property| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 font-medium text-gray-900"><%= property.name %></td>
              <td class="px-4 py-3 text-gray-600"><%= property.address %></td>
              <td class="px-4 py-3">
                <% progress = property.guide_progress %>
                <% percentage = progress[:total].positive? ? (progress[:filled].to_f / progress[:total] * 100).round : 0 %>
                <span class="font-medium text-gray-900"><%= progress[:filled] %>/<%= progress[:total] %></span>
                <span class="ml-2 text-gray-500">(<%= percentage %>%)</span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="p-8 text-center text-gray-500">
      Nenhuma hospedagem cadastrada.
    </div>
  <% end %>
</section>