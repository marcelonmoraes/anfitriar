<div class="mb-6">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900">Minha conta</h1>
  <p class="mt-1 text-sm text-gray-600">Gerencie seus dados de perfil e veja as informações da sua assinatura</p>
</div>

<% if @subscription %>
  <div class="mb-8 rounded-xl border border-gray-200 bg-white p-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold uppercase tracking-wide text-gray-500">Plano atual</span>
          <% if @subscription.trial? %>
            <span class="rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-800">Período de teste</span>
          <% elsif @subscription.status == "active" %>
            <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800">Ativa</span>
          <% end %>
        </div>
        <h2 class="mt-1 text-xl font-bold text-gray-900">Plano <%= @subscription.plan.name %></h2>
        <p class="mt-1 text-sm text-gray-600">
          Status: <strong class="text-gray-900"><%= subscription_status_label(@subscription) %></strong>
          <% if @subscription.trial? %>
            — <span class="font-medium text-gray-900"><%= @subscription.trial_days_left %> dias restantes</span>
          <% end %>
        </p>
      </div>
      <% if @subscription.trial? %>
        <div class="shrink-0">
          <p class="text-xs text-gray-500">Aproveite para cadastrar seus imóveis</p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<div class="rounded-xl border border-gray-200 bg-white p-5 max-w-lg">
  <h2 class="text-lg font-semibold text-gray-900 mb-4">Dados cadastrais</h2>

  <%= form_with model: @host, url: account_path, method: :patch, class: "space-y-4" do |f| %>
    <%= render "shared/form_errors", record: @host %>
    <div>
      <%= f.label :name, "Nome completo", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, required: true, autofocus: true,
            class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none text-sm px-3.5 py-2.5" %>
    </div>
    <div>
      <%= f.label :email_address, "E-mail", class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email_address, required: true, autocomplete: "username",
            class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none text-sm px-3.5 py-2.5" %>
    </div>
    <div>
      <%= f.label :phone, "Telefone", class: "block text-sm font-medium text-gray-700" %>
      <%= f.telephone_field :phone, required: true, placeholder: "(11) 98765-4321",
            class: "mt-1.5 w-full rounded-lg border-gray-300 shadow-sm focus:border-gray-900 focus:ring-1 focus:ring-gray-900 focus:outline-none text-sm px-3.5 py-2.5 font-mono" %>
    </div>
    <div class="pt-2">
      <%= f.submit "Salvar alterações", class: "rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 active:bg-gray-950 cursor-pointer" %>
    </div>
  <% end %>
</div>