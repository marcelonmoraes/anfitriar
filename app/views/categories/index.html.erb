<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold">Categorias</h1>
  <%= link_to "Nova categoria", new_category_path,
        class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 active:bg-gray-950" %>
</div>

<section aria-labelledby="standard-categories-heading" class="mb-8">
  <h2 id="standard-categories-heading" class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">Padrão do sistema</h2>
  <p class="mb-3 text-sm text-gray-500">Estas categorias existem em todas as contas. Você preenche a descrição de cada uma dentro de cada hospedagem — e pode ocultá-las por hospedagem, mas não excluí-las.</p>
  <ul class="grid gap-2 sm:grid-cols-2">
    <% @standard_categories.each do |category| %>
      <li class="rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm"><%= category.name %></li>
    <% end %>
  </ul>
</section>

<section aria-labelledby="own-categories-heading">
  <h2 id="own-categories-heading" class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">Minhas categorias</h2>
  <% if @own_categories.none? %>
    <p class="rounded-lg border border-dashed border-gray-300 p-8 text-center text-gray-500">
      Crie categorias próprias para assuntos que só existem nas suas hospedagens.
    </p>
  <% else %>
    <ul class="grid gap-2 sm:grid-cols-2">
      <% @own_categories.each do |category| %>
        <li class="flex items-center justify-between rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm">
          <span><%= category.name %></span>
          <span class="flex items-center gap-3">
            <%= link_to "Editar", edit_category_path(category),
                  class: "rounded font-medium text-gray-700 underline-offset-2 hover:underline focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2",
                  aria: { label: "Editar #{category.name}" } %>
            <%= button_to "Excluir", category_path(category), method: :delete,
                  class: "rounded font-medium text-red-700 underline-offset-2 hover:underline focus:outline-none focus:ring-2 focus:ring-red-600 focus:ring-offset-2",
                  form: { class: "inline", data: { turbo_confirm: "Excluir esta categoria remove os cards dela em todas as hospedagens. Confirmar?" } },
                  aria: { label: "Excluir #{category.name}" } %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
