<% content_for :title, "Assinatura — Anfitriar" %>

<div class="mx-auto max-w-2xl">
  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900">Assinatura</h1>
    <%= render "subscriptions/status_badge", subscription: @subscription %>
  </header>

  <% if @subscription.new_record? %>
    <div class="rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center">
      <h2 class="text-sm font-semibold text-gray-900">Você ainda não tem uma assinatura</h2>
      <p class="mt-1 text-sm text-gray-500">Assine para manter seus guias no ar.</p>
      <%= link_to "Ver planos", new_account_subscription_path,
            class: "mt-4 inline-flex rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-gray-800" %>
    </div>
  <% else %>
    <% if @subscription.trial? %>
      <div class="mb-6 rounded-xl border p-4 <%= @subscription.trial_expired? ? 'border-red-200 bg-red-50' : 'border-blue-200 bg-blue-50' %>" role="status">
        <% if @subscription.trial_expired? %>
          <h2 class="text-sm font-semibold text-red-900">Seu período de teste terminou</h2>
          <p class="mt-1 text-sm text-red-800">Seus guias estão fora do ar. Assine para reativá-los.</p>
        <% else %>
          <h2 class="text-sm font-semibold text-blue-900">
            Teste grátis — <%= pluralize(@subscription.trial_days_left, "dia restante", plural: "dias restantes") %>
          </h2>
          <p class="mt-1 text-sm text-blue-800">Assine antes do fim do teste para não interromper seus guias.</p>
        <% end %>
        <%= link_to "Assinar agora", new_account_subscription_path,
              class: "mt-3 inline-flex rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800" %>
      </div>
    <% elsif @subscription.past_due? %>
      <div class="mb-6 rounded-xl border border-amber-200 bg-amber-50 p-4" role="alert">
        <h2 class="text-sm font-semibold text-amber-900">Pagamento pendente</h2>
        <p class="mt-1 text-sm text-amber-800">
          Não conseguimos cobrar seu cartão. Atualize a forma de pagamento para evitar a suspensão dos guias.
        </p>
        <%= link_to "Gerenciar cartões", account_credit_cards_path,
              class: "mt-3 inline-flex rounded-lg bg-amber-900 px-4 py-2 text-sm font-medium text-white hover:bg-amber-800" %>
      </div>
    <% elsif @subscription.pending? %>
      <div class="mb-6 rounded-xl border border-blue-200 bg-blue-50 p-4" role="status">
        <h2 class="text-sm font-semibold text-blue-900">Aguardando confirmação do pagamento</h2>
        <p class="mt-1 text-sm text-blue-800">Assim que a operadora aprovar, sua assinatura será ativada.</p>
      </div>
    <% end %>

    <section class="rounded-xl border border-gray-200 bg-white p-5">
      <dl class="grid gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Plano</dt>
          <dd class="mt-1 font-semibold text-gray-900"><%= @subscription.plan.name %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Ciclo</dt>
          <dd class="mt-1 font-semibold text-gray-900">
            <%= @subscription.billing_cycle ? t("subscriptions.cycles.#{@subscription.billing_cycle}") : "—" %>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Valor</dt>
          <dd class="mt-1 font-semibold text-gray-900"><%= number_to_currency(@subscription.price) %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Próxima cobrança</dt>
          <dd class="mt-1 font-semibold text-gray-900">
            <%= @subscription.current_period_end ? l(@subscription.current_period_end.to_date, format: :long) : "—" %>
          </dd>
        </div>
        <% if @subscription.credit_card %>
          <div class="sm:col-span-2">
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Cartão</dt>
            <dd class="mt-1 font-semibold text-gray-900"><%= @subscription.credit_card %></dd>
          </div>
        <% end %>
      </dl>

      <div class="mt-5 flex flex-wrap gap-3 border-t border-gray-200 pt-5">
        <%= link_to "Gerenciar cartões", account_credit_cards_path,
              class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" %>

        <% if @subscription.active? || @subscription.past_due? %>
          <%= link_to "Mudar de plano", edit_account_subscription_path,
                class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
          <%= button_to "Cancelar assinatura", account_subscription_path, method: :delete,
                class: "rounded-lg border border-red-200 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50",
                form: { data: { turbo_confirm: "Cancelar a assinatura? Seus guias sairão do ar ao fim do período pago." } } %>
        <% elsif @subscription.canceled? %>
          <%= link_to "Reativar assinatura", new_account_subscription_path,
                class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800" %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
