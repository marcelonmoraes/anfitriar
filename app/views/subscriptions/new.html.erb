<% content_for :title, "Assinar — Anfitriar" %>

<div class="mx-auto max-w-2xl">
  <header class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900">Assinar o Anfitriar</h1>
    <p class="mt-1 text-sm text-gray-600">
      Escolha seu plano e informe o cartão. A cobrança é recorrente e você pode cancelar quando quiser.
    </p>
  </header>

  <% unless Current.host.billing_profile_complete? %>
    <div class="mb-6 rounded-xl border border-amber-200 bg-amber-50 p-4" role="alert">
      <h2 class="text-sm font-semibold text-amber-900">Complete seus dados de cobrança</h2>
      <p class="mt-1 text-sm text-amber-800">
        Precisamos do seu CPF/CNPJ, CEP e número do endereço para emitir a cobrança.
      </p>
      <%= link_to "Completar cadastro", account_path,
            class: "mt-3 inline-flex rounded-lg bg-amber-900 px-4 py-2 text-sm font-medium text-white hover:bg-amber-800" %>
    </div>
  <% end %>

  <%= form_with model: @subscription, url: account_subscription_path, class: "space-y-6",
        data: { controller: "credit-card", action: "submit->credit-card#submit" } do |form| %>
    <%= render "shared/form_errors", record: @subscription %>
    <%= render "shared/form_errors", record: @credit_card_form %>

    <section class="rounded-xl border border-gray-200 bg-white p-5">
      <h2 class="text-lg font-semibold text-gray-900">Plano</h2>

      <fieldset class="mt-4 space-y-3">
        <legend class="sr-only">Escolha o plano</legend>
        <% @plans.each do |plan| %>
          <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-gray-200 p-4 transition-colors hover:border-gray-400 has-[:checked]:border-gray-900 has-[:checked]:bg-gray-50">
            <%= form.radio_button :plan_id, plan.id, class: "mt-1 h-4 w-4 border-gray-300 text-gray-900 focus:ring-gray-900" %>
            <span class="flex-1">
              <span class="block font-medium text-gray-900"><%= plan.name %></span>
              <span class="block text-sm text-gray-500">
                <%= number_to_currency(plan.monthly_price_cents / 100.0) %> por mês
                ·
                <%= plan.max_properties ? "até #{plan.max_properties} #{'hospedagem'.pluralize(plan.max_properties)}" : "hospedagens ilimitadas" %>
              </span>
            </span>
          </label>
        <% end %>
      </fieldset>
    </section>

    <section class="rounded-xl border border-gray-200 bg-white p-5">
      <h2 class="text-lg font-semibold text-gray-900">Ciclo de cobrança</h2>

      <fieldset class="mt-4 grid gap-3 sm:grid-cols-2">
        <legend class="sr-only">Escolha o ciclo de cobrança</legend>
        <% Subscription::CYCLES.each do |cycle| %>
          <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-gray-200 p-4 transition-colors hover:border-gray-400 has-[:checked]:border-gray-900 has-[:checked]:bg-gray-50">
            <%= form.radio_button :billing_cycle, cycle, class: "h-4 w-4 border-gray-300 text-gray-900 focus:ring-gray-900" %>
            <span class="font-medium text-gray-900"><%= t("subscriptions.cycles.#{cycle}") %></span>
          </label>
        <% end %>
      </fieldset>
    </section>

    <section class="rounded-xl border border-gray-200 bg-white p-5">
      <h2 class="text-lg font-semibold text-gray-900">Pagamento</h2>

      <% if @credit_cards.any? %>
        <fieldset class="mt-4 space-y-3">
          <legend class="sr-only">Escolha o cartão</legend>
          <% @credit_cards.each do |credit_card| %>
            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-gray-200 p-4 transition-colors hover:border-gray-400 has-[:checked]:border-gray-900 has-[:checked]:bg-gray-50">
              <%= radio_button_tag :credit_card_id, credit_card.id, credit_card.default?,
                    class: "h-4 w-4 border-gray-300 text-gray-900 focus:ring-gray-900" %>
              <span class="flex-1">
                <span class="block font-medium text-gray-900"><%= credit_card %></span>
                <span class="block text-sm text-gray-500">Expira em <%= credit_card.expires_on %></span>
              </span>
            </label>
          <% end %>

          <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-gray-200 p-4 transition-colors hover:border-gray-400 has-[:checked]:border-gray-900 has-[:checked]:bg-gray-50">
            <%= radio_button_tag :credit_card_id, "", false,
                  class: "h-4 w-4 border-gray-300 text-gray-900 focus:ring-gray-900" %>
            <span class="font-medium text-gray-900">Usar um novo cartão</span>
          </label>
        </fieldset>

      <% end %>

      <div class="<%= @credit_cards.any? ? "mt-5 border-t border-gray-200 pt-5" : "mt-4" %>">
        <%= fields_for :credit_card, @credit_card_form do |card_fields| %>
          <%= render "credit_cards/fields", form: card_fields %>
        <% end %>
      </div>
    </section>

    <div class="flex items-center justify-end gap-3">
      <%= link_to "Cancelar", account_subscription_path,
            class: "rounded-lg px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-900" %>
      <%= form.submit "Assinar agora",
            class: "rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-gray-800 disabled:opacity-60",
            data: { credit_card_target: "submit" } %>
    </div>
  <% end %>
</div>
