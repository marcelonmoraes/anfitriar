<% return if subscription.new_record? %>
<%
  styles = {
    "trial" => "bg-blue-100 text-blue-800",
    "pending" => "bg-blue-100 text-blue-800",
    "active" => "bg-green-100 text-green-800",
    "past_due" => "bg-amber-100 text-amber-800",
    "canceled" => "bg-gray-100 text-gray-700"
  }
%>
<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= styles.fetch(subscription.status, "bg-gray-100 text-gray-700") %>">
  <%= t("subscriptions.statuses.#{subscription.status}") %>
</span>
