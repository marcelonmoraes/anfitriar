# Copie para .env e preencha. O .env não vai para o Git.
#
#   cp .env.example .env
#
# Em produção, defina estas variáveis no servidor (não use arquivo .env).

# ---------------------------------------------------------------------------
# Asaas — assinaturas e cobrança recorrente
# ---------------------------------------------------------------------------

# Chave de API. Painel Asaas > Integrações > Chave de API.
# SEGREDO: só o backend usa. Nunca exponha em views ou JavaScript.
# Sandbox e produção têm chaves diferentes.
ASAAS_API_KEY=

# Token de autenticação do webhook, definido por você.
# Painel Asaas > Integrações > Webhooks > campo "Token de autenticação".
# Precisa ser idêntico aqui e lá: é o que valida cada evento recebido.
# Gere um valor forte com: openssl rand -hex 32
ASAAS_WEBHOOK_SECRET=

# Define contra qual API falamos.
# Use "production" apenas no ambiente real; qualquer outro valor usa o sandbox.
ASAAS_ENVIRONMENT=sandbox
